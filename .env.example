# Optional local overrides. Bot-Hosting supplies SERVER_PORT automatically; no variables are required for the dashboard to start.
# Default Dashboard password: vortex5000 (change before exposing it publicly)
DASHBOARD_PASSWORD=vortex5000
# If omitted, a random secret is created and saved in data/session-secret.
SESSION_SECRET=
# Optional AppState JSON array; safer to enter it in the Dashboard.
APPSTATE_JSON=
# Messenger account ID with owner privileges (recommended)
OWNER_ID=
# Optional comma-separated Messenger admin IDs; dashboard changes can also manage these
ADMIN_IDS=
# Optional separate password for read-only dashboard admin access
ADMIN_DASHBOARD_PASSWORD=
# Optional display overrides
PREFIX=*
BOT_NAME=VORTEX
PORT=3000
# On Bot-Hosting, SERVER_PORT is injected automatically. Locally, NODE_ENV defaults to development.
NODE_ENV=development
